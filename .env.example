# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (multimodal extraction, tool-use agent loop) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Database ---
DATABASE_URL=sqlite:///./ecommerce_agent.db

# --- Google Drive (product image ingestion) ---
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Notion (optional secondary export target) ---
NOTION_API_KEY=
NOTION_SOURCE_DB_ID=
NOTION_TARGET_DB_ID=

# --- Agent behavior ---
MAX_AGENT_ITERATIONS=6
CONFIDENCE_THRESHOLD=0.7

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
