# Copy this file to .env and fill in real values. Never commit .env.
# Values below are for local development. On Render (see render.yaml / README) they are set in the
# dashboard instead - notes marked "Render:" show the deployed value.

# --- LLM provider (multimodal extraction, tool-use agent loop) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Database ---
# Render: postgresql://... (filled in automatically from the Render PostgreSQL database)
DATABASE_URL=sqlite:///./ecommerce_agent.db

# --- Google Drive (product image ingestion) ---
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Sign in with Google (OAuth/OIDC login - NOT the Drive service account above) ---
# OAuth client ("Web application") from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register there: {FRONTEND_BASE_URL}/auth/google/callback
# Leave both empty to hide the "Continue with Google" button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Notion (optional secondary export target) ---
NOTION_API_KEY=
NOTION_SOURCE_DB_ID=
NOTION_TARGET_DB_ID=

# --- Stripe Checkout (TEST MODE ONLY - live keys are rejected) ---
# Secret key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=
# Signing secret printed by `stripe listen --forward-to localhost:8000/payments/webhook` (whsec_...)
# Render: the signing secret of the Dashboard endpoint https://<service>.onrender.com/payments/webhook
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects the browser after checkout; also the base of the Google redirect URI.
# Render: https://<service>.onrender.com (https also turns on Secure cookies)
FRONTEND_BASE_URL=http://localhost:8000

# --- Agent behavior ---
MAX_AGENT_ITERATIONS=6
CONFIDENCE_THRESHOLD=0.7

# --- App ---
# Render: production (error responses then hide internal exception details)
APP_ENV=development
LOG_LEVEL=INFO
